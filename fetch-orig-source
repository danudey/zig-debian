#!/bin/sh
# Download an upstream Zig binary release, verify it, and repack it as the
# Debian orig tarball expected by this packaging.
#
# Usage: fetch-orig-source [VERSION] [DEB_ARCH]
#
#   VERSION   upstream version (default: from debian/changelog)
#   DEB_ARCH  Debian architecture (default: dpkg --print-architecture)
#
# Writes zig_VERSION.orig.tar.xz into the current directory and
# verifies both the SHA-256 published in upstream's index.json and the
# minisign signature made with the Zig Software Foundation release key.
#
# Set ZIG_SKIP_MINISIGN=1 to rely on the SHA-256 check alone (not
# recommended: the hash and the tarball come from the same server).

set -eu

# Upstream release signing key, from https://ziglang.org/download/
ZIG_PUBKEY='RWSGOq2NVecA2UPNdBUZykf1CCb147pkmdtYxgb3Ti+JO/wCYvhbAb/U'
BASE_URL='https://ziglang.org/download'

here=$(cd "$(dirname "$0")" && pwd)

version=${1:-$(dpkg-parsechangelog -l "$here/changelog" -S Version | sed 's/-[^-]*$//; s/^[0-9]*://')}
deb_arch=${2:-$(dpkg --print-architecture)}

case "$version" in
  *[!0-9A-Za-z.+~-]*|'') echo "error: invalid version '$version'" >&2; exit 1 ;;
esac

# Debian architecture -> upstream architecture name.
case "$deb_arch" in
  amd64) zig_arch=x86_64 ;;
  arm64) zig_arch=aarch64 ;;
  *) echo "error: unsupported architecture '$deb_arch'" >&2; exit 1 ;;
esac

for tool in curl jq sha256sum tar xz; do
  command -v "$tool" >/dev/null || { echo "error: '$tool' is required" >&2; exit 1; }
done
if [ "${ZIG_SKIP_MINISIGN:-0}" != 1 ] && ! command -v minisign >/dev/null; then
  echo "error: 'minisign' is required (apt install minisign)," >&2
  echo "       or set ZIG_SKIP_MINISIGN=1 to skip signature checks" >&2
  exit 1
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM

fetch() { curl --proto '=https' --tlsv1.2 -fsSL --retry 3 -o "$2" "$1"; }

echo "Fetching release index..."
fetch "$BASE_URL/index.json" "$work/index.json"

key="$zig_arch-linux"
url=$(jq -er --arg v "$version" --arg k "$key" '.[$v][$k].tarball' "$work/index.json") || {
  echo "error: no $key tarball for zig $version in index.json" >&2; exit 1; }
sha=$(jq -er --arg v "$version" --arg k "$key" '.[$v][$k].shasum' "$work/index.json")

case "$url" in
  "$BASE_URL"/*) ;;
  *) echo "error: unexpected tarball URL '$url'" >&2; exit 1 ;;
esac

name=${url##*/}
echo "Fetching $url..."
fetch "$url" "$work/$name"

echo "$sha  $work/$name" | sha256sum -c --quiet - || {
  echo "error: SHA-256 mismatch for $name" >&2; exit 1; }
echo "SHA-256 OK"

if [ "${ZIG_SKIP_MINISIGN:-0}" != 1 ]; then
  fetch "$url.minisig" "$work/$name.minisig"
  minisign -Vm "$work/$name" -x "$work/$name.minisig" -P "$ZIG_PUBKEY" -q || {
    echo "error: minisign verification failed for $name" >&2; exit 1; }
  # The trusted comment is covered by the signature; make sure it names
  # this file so a valid signature for a different release is rejected.
  sed -n 's/^trusted comment: //p' "$work/$name.minisig" | tr '\t' '\n' | \
    grep -qxF "file:$name" || {
    echo "error: signature does not belong to $name" >&2; exit 1; }
  echo "Signature OK"
else
  echo "warning: skipping minisign verification" >&2
fi

mkdir "$work/x"
tar -xJf "$work/$name" -C "$work/x"
top=$(ls "$work/x")
[ "$(echo "$top" | wc -l)" = 1 ] && [ -x "$work/x/$top/zig" ] || {
  echo "error: unexpected tarball layout" >&2; exit 1; }

out="$PWD/zig_$version.orig.tar.xz"
[ ! -e "$out" ] || { echo "error: $out already exists" >&2; exit 1; }

mv "$work/x/$top" "$work/x/zig-$version"
tar -C "$work/x" --sort=name --owner=0 --group=0 --numeric-owner \
  --mtime="@$(stat -c %Y "$work/x/zig-$version/zig")" \
  -cf - "zig-$version" | xz -T0 -6 > "$out.tmp"
mv "$out.tmp" "$out"
echo "Wrote $out"
