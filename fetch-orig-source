#!/bin/sh
# Download the upstream Zig source release for the version in
# debian/changelog, verify it, and repack it as the Debian orig tarball.
#
# Usage: debian/fetch-orig-source [--unpack]
#
#   --unpack  also unpack the orig tarball into the package directory
#             (the parent of debian/), ready to build
#
# The orig tarball is written next to the package directory, as
# ../SOURCE_VERSION.orig.tar.xz (e.g. ../zig0.17_0.17.0+ds1.orig.tar.xz),
# which is where dpkg-source and dpkg-buildpackage look for it. An existing
# orig tarball is reused.
#
# The download is checked against both the SHA-256 published in upstream's
# index.json and the minisign signature made with the Zig release key in
# debian/upstream/signing-key. Files listed in Files-Excluded in
# debian/copyright are removed by mk-origtargz, which appends the +dsN
# repack suffix ("Debian source": upstream's tarball with files removed).
#
# Set ZIG_SKIP_MINISIGN=1 to rely on the SHA-256 check alone (not
# recommended: the hash and the tarball come from the same server).

set -eu

BASE_URL='https://ziglang.org/download'

unpack=0
for arg in "$@"; do
  case "$arg" in
    --unpack) unpack=1 ;;
    -h|--help) sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; exit 0 ;;
    *) echo "error: unknown argument '$arg'" >&2; exit 1 ;;
  esac
done

debian=$(cd "$(dirname "$0")" && pwd)
pkgdir=$(dirname "$debian")
outdir=$(dirname "$pkgdir")

source=$(dpkg-parsechangelog -l "$debian/changelog" -S Source)
debversion=$(dpkg-parsechangelog -l "$debian/changelog" -S Version)
# 1:0.17.0+ds1-1~ppa1 -> 0.17.0+ds1 -> 0.17.0 and +ds1
origversion=$(echo "$debversion" | sed 's/^[0-9]*://; s/-[^-]*$//')
version=$(echo "$origversion" | sed 's/+ds[0-9]*$//')
suffix=${origversion#"$version"}

case "$version" in
  *[!0-9.]*|'') echo "error: unexpected upstream version '$version'" >&2; exit 1 ;;
esac

orig="$outdir/${source}_$origversion.orig.tar.xz"

if [ -e "$orig" ]; then
  echo "Using existing $orig"
else
  for tool in curl jq sha256sum mk-origtargz; do
    command -v "$tool" >/dev/null || {
      echo "error: '$tool' is required (apt install curl jq coreutils devscripts)" >&2; exit 1; }
  done
  if [ "${ZIG_SKIP_MINISIGN:-0}" != 1 ] && ! command -v minisign >/dev/null; then
    echo "error: 'minisign' is required (apt install minisign)," >&2
    echo "       or set ZIG_SKIP_MINISIGN=1 to skip signature checks" >&2
    exit 1
  fi

  work=$(mktemp -d)
  trap 'rm -rf "$work"' EXIT INT TERM

  fetch() { curl --proto '=https' --tlsv1.2 -fsSL --retry 3 -o "$2" "$1"; }

  echo "Fetching release index..."
  fetch "$BASE_URL/index.json" "$work/index.json"

  url=$(jq -er --arg v "$version" '.[$v].src.tarball' "$work/index.json") || {
    echo "error: no source tarball for zig $version in index.json" >&2; exit 1; }
  sha=$(jq -er --arg v "$version" '.[$v].src.shasum' "$work/index.json")

  case "$url" in
    "$BASE_URL"/*) ;;
    *) echo "error: unexpected tarball URL '$url'" >&2; exit 1 ;;
  esac

  name=${url##*/}
  echo "Fetching $url..."
  fetch "$url" "$work/$name"

  echo "$sha  $work/$name" | sha256sum -c --quiet - || {
    echo "error: SHA-256 mismatch for $name" >&2; exit 1; }
  echo "SHA-256 OK"

  if [ "${ZIG_SKIP_MINISIGN:-0}" != 1 ]; then
    fetch "$url.minisig" "$work/$name.minisig"
    minisign -Vm "$work/$name" -x "$work/$name.minisig" \
      -P "$(cat "$debian/upstream/signing-key")" -q || {
      echo "error: minisign verification failed for $name" >&2; exit 1; }
    # The trusted comment is covered by the signature; make sure it names
    # this file so a valid signature for a different release is rejected.
    sed -n 's/^trusted comment: //p' "$work/$name.minisig" | tr '\t' '\n' | \
      grep -qxF "file:$name" || {
      echo "error: signature does not belong to $name" >&2; exit 1; }
    echo "Signature OK"
  else
    echo "warning: skipping minisign verification" >&2
  fi

  # Remove Files-Excluded and write ../SOURCE_VERSION+dsN.orig.tar.xz.
  mk-origtargz --package "$source" --version "$version" \
    --repack-suffix "$suffix" --compression xz \
    --copyright-file "$debian/copyright" \
    --directory "$work" --copy "$work/$name"
  [ -e "$work/${source}_$origversion.orig.tar.xz" ] || {
    echo "error: mk-origtargz did not produce ${source}_$origversion.orig.tar.xz;" >&2
    echo "       check Files-Excluded in debian/copyright and the +dsN suffix" >&2
    echo "       in debian/changelog" >&2
    exit 1; }
  mv "$work/${source}_$origversion.orig.tar.xz" "$orig"
  echo "Wrote $orig"
fi

if [ "$unpack" = 1 ]; then
  if [ -e "$pkgdir/CMakeLists.txt" ]; then
    echo "error: $pkgdir already contains upstream source" >&2
    exit 1
  fi
  echo "Unpacking into $pkgdir"
  tar -xJf "$orig" -C "$pkgdir" --strip-components=1
fi
