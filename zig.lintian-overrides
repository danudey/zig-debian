# Upstream ships a single statically linked, stripped compiler binary.
zig: statically-linked-binary [usr/lib/zig/zig]
zig: embedded-library zlib [usr/lib/zig/zig]

# Upstream's man page does not exist.
zig: no-manual-page [usr/bin/zig]

# lib/ is the compiler's bundled library source tree, used as-is: it
# carries upstream's license files, HTML front-ends, empty test-data
# directories, and vendored headers in legacy encodings.
zig: extra-license-file [usr/lib/zig/lib/*]
zig: package-contains-documentation-outside-usr-share-doc [usr/lib/zig/lib/*]
zig: package-contains-empty-directory [usr/lib/zig/lib/*]
zig: national-encoding [usr/lib/zig/lib/libc/*]
